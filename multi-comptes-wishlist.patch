diff --git a/frontend/src/context/WishlistContext.tsx b/frontend/src/context/WishlistContext.tsx
new file mode 100644
index 0000000..c6c4180
--- /dev/null
+++ b/frontend/src/context/WishlistContext.tsx
@@ -0,0 +1,96 @@
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useState,
+  type ReactNode,
+} from 'react';
+import type { SkinInfo } from '../types';
+
+const STORAGE_KEY = 'wishlist';
+
+/** What we keep about a wishlisted skin (enough to display it without the backend). */
+type WishlistSkin = SkinInfo;
+
+function normalize(skin: Partial<SkinInfo> & { uuid: string; name: string }): WishlistSkin {
+  return {
+    uuid: skin.uuid,
+    name: skin.name,
+    display_icon: skin.display_icon ?? '',
+    content_tier_uuid: skin.content_tier_uuid ?? '',
+    content_tier_name: skin.content_tier_name ?? '',
+    content_tier_color: skin.content_tier_color ?? '',
+  };
+}
+
+function loadWishlist(): WishlistSkin[] {
+  try {
+    const parsed: unknown = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]');
+    if (!Array.isArray(parsed)) return [];
+    return parsed
+      .filter(
+        (s): s is SkinInfo =>
+          typeof s === 'object' &&
+          s !== null &&
+          typeof s.uuid === 'string' &&
+          typeof s.name === 'string',
+      )
+      .map(normalize);
+  } catch {
+    return [];
+  }
+}
+
+interface WishlistContextValue {
+  skins: WishlistSkin[];
+  has: (uuid: string | null | undefined) => boolean;
+  /** Add the skin if it isn't wishlisted, remove it otherwise. */
+  toggle: (skin: Partial<SkinInfo> & { uuid: string; name: string }) => void;
+  remove: (uuid: string) => void;
+}
+
+const WishlistContext = createContext<WishlistContextValue>({
+  skins: [],
+  has: () => false,
+  toggle: () => undefined,
+  remove: () => undefined,
+});
+
+// eslint-disable-next-line react-refresh/only-export-components
+export function useWishlist() {
+  return useContext(WishlistContext);
+}
+
+export function WishlistProvider({ children }: { children: ReactNode }) {
+  const [skins, setSkins] = useState<WishlistSkin[]>(loadWishlist);
+
+  useEffect(() => {
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(skins));
+    } catch {
+      // Storage unavailable: the wishlist just won't survive a reload.
+    }
+  }, [skins]);
+
+  const ids = useMemo(() => new Set(skins.map((s) => s.uuid)), [skins]);
+
+  const has = useCallback((uuid: string | null | undefined) => !!uuid && ids.has(uuid), [ids]);
+
+  const toggle = useCallback<WishlistContextValue['toggle']>((skin) => {
+    setSkins((prev) =>
+      prev.some((s) => s.uuid === skin.uuid)
+        ? prev.filter((s) => s.uuid !== skin.uuid)
+        : [...prev, normalize(skin)],
+    );
+  }, []);
+
+  const remove = useCallback((uuid: string) => {
+    setSkins((prev) => prev.filter((s) => s.uuid !== uuid));
+  }, []);
+
+  const value = useMemo(() => ({ skins, has, toggle, remove }), [skins, has, toggle, remove]);
+
+  return <WishlistContext.Provider value={value}>{children}</WishlistContext.Provider>;
+}
diff --git a/frontend/src/context/authReducer.ts b/frontend/src/context/authReducer.ts
new file mode 100644
index 0000000..5269835
--- /dev/null
+++ b/frontend/src/context/authReducer.ts
@@ -0,0 +1,59 @@
+import type { Account, AuthAction, AuthState } from '../types';
+
+export const initialState: AuthState = {
+  status: 'idle',
+  sessionValid: false,
+  puuid: null,
+  accounts: [],
+};
+
+/**
+ * Build the auth state for a list of accounts. The active account is the preferred
+ * one if it is still usable, otherwise the first account whose session hasn't expired.
+ */
+function withActive(accounts: Account[], preferred: string | null): AuthState {
+  const active =
+    accounts.find((a) => a.puuid === preferred && !a.expired) ??
+    accounts.find((a) => !a.expired) ??
+    null;
+
+  return {
+    accounts,
+    puuid: active?.puuid ?? null,
+    status: active ? 'authenticated' : 'unauthenticated',
+    sessionValid: active !== null,
+  };
+}
+
+export function authReducer(state: AuthState, action: AuthAction): AuthState {
+  switch (action.type) {
+    case 'ACCOUNTS_LOADED': {
+      // An account may have been added while the startup check was still running.
+      const added = state.accounts;
+      const loaded = action.accounts.filter((a) => !added.some((x) => x.puuid === a.puuid));
+      return withActive([...loaded, ...added], state.puuid ?? action.activePuuid);
+    }
+    case 'LOGIN_SUCCESS': {
+      const exists = state.accounts.some((a) => a.puuid === action.account.puuid);
+      // Logging into an account that is already listed replaces its (expired) session.
+      const accounts = exists
+        ? state.accounts.map((a) => (a.puuid === action.account.puuid ? action.account : a))
+        : [...state.accounts, action.account];
+      return withActive(accounts, action.account.puuid);
+    }
+    case 'SWITCH_ACCOUNT':
+      return withActive(state.accounts, action.puuid);
+    case 'REMOVE_ACCOUNT':
+      return withActive(
+        state.accounts.filter((a) => a.puuid !== action.puuid),
+        state.puuid,
+      );
+    case 'ACCOUNT_EXPIRED':
+      return withActive(
+        state.accounts.map((a) => (a.puuid === action.puuid ? { ...a, expired: true } : a)),
+        state.puuid,
+      );
+    case 'LOGOUT_ALL':
+      return { ...initialState, status: 'unauthenticated' };
+  }
+}
